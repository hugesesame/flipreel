{
  "name": "flipreel",
  "version": "0.1.0",
  "private": true,
  "description": "Turn still photos into a slideshow video, right in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "screenshots": "npm run build && node tools/screenshots/shoot.mjs",
    "screenshot-samples": "node tools/screenshots/make-samples.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "mediabunny": "^1.65.2"
  }
}
